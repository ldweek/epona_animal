<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Surface the SEPA export action and the export history on the
        batch payment form. The button only renders for outbound
        batches that have already been posted.
    -->
    <record id="view_eh_batch_payment_form_sepa" model="ir.ui.view">
        <field name="name">eh.batch.payment.form.sepa</field>
        <field name="model">eh.batch.payment</field>
        <field name="inherit_id" ref="eh_account_batch_payment.view_eh_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_export_csv']" position="after">
                <button name="action_export_sepa_ct"
                        type="object"
                        string="Export SEPA"
                        groups="eh_account_base.group_eh_manager"
                        invisible="state != 'posted' or batch_type != 'outbound' or not sepa_ct_enabled"
                        confirm="Generate the PAIN.001 SEPA Credit Transfer XML for upload to the bank. Continue?"/>
                <button name="action_reapprove_sepa_ct_sources"
                        type="object" string="Re-approve SEPA Sources"
                        groups="eh_account_base.group_eh_manager"
                        invisible="state != 'posted' or batch_type != 'outbound' or not sepa_ct_enabled"
                        confirm="Approve the current originator and recipient banking data for this posted batch? A different manager must export."/>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='payment_method_line_id']" position="after">
                <field name="sepa_ct_enabled"
                       readonly="state != 'draft'"
                       invisible="batch_type != 'outbound'"/>
            </xpath>
            <xpath expr="//field[@name='payment_ids']/*/field[@name='partner_bank_id']" position="after">
                <field name="sepa_ct_structured_reference"
                       optional="show"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="SEPA exports"
                      groups="eh_account_base.group_eh_manager,eh_account_base.group_eh_auditor"
                      invisible="batch_type != 'outbound' or not sepa_ct_enabled">
                    <field name="last_sepa_export_id" invisible="1"/>
                    <group>
                        <field name="sepa_ct_source_approved_at" readonly="1"/>
                        <field name="sepa_ct_source_approved_by_id" readonly="1"/>
                        <field name="sepa_ct_reapproval_reason"
                               placeholder="Reason and evidence for changed source data (minimum 20 characters)"/>
                    </group>
                    <field name="sepa_ct_source_approval_ids" readonly="1">
                        <list>
                            <field name="approved_at"/>
                            <field name="approved_by_id"/>
                            <field name="reason"/>
                            <field name="source_fingerprint" optional="hide"/>
                        </list>
                    </field>
                    <field name="sepa_export_ids" readonly="1">
                        <list>
                            <field name="generated_at"/>
                            <field name="message_id"/>
                            <field name="transaction_count"/>
                            <field name="control_sum"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'downloaded'"
                                   decoration-info="state == 'generated'"
                                   decoration-muted="state == 'superseded'"/>
                            <button name="action_download"
                                    type="object" icon="fa-download"
                                    string="Download"
                                    invisible="state == 'superseded'"/>
                            <button name="action_void_for_recut"
                                    type="object" icon="fa-ban"
                                    string="Void for re-cut"
                                    invisible="state == 'superseded'"
                                    confirm="Void this SEPA file so the batch can be re-exported? Do this ONLY if the file was not submitted to the bank."/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
