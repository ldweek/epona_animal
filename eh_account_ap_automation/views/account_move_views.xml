<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_eh_release_to_pay" model="ir.ui.view">
        <field name="name">account.move.form.eh.release.to.pay</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="eh_payment_hold" invisible="1"/>
                <field name="eh_exception_waived" invisible="1"/>
                <button name="action_eh_hold_payment" type="object"
                        string="Hold Payment"
                        groups="eh_account_base.group_eh_manager"
                        invisible="move_type != 'in_invoice' or state != 'posted' or eh_payment_hold"/>
                <button name="action_eh_release_payment" type="object"
                        string="Release Payment"
                        groups="eh_account_base.group_eh_manager"
                        invisible="move_type != 'in_invoice' or not eh_payment_hold"/>
                <button name="action_eh_waive_billing_exception" type="object"
                        string="Waive Billing Exception"
                        groups="eh_account_base.group_eh_manager"
                        invisible="move_type != 'in_invoice' or state != 'posted' or eh_payment_hold or eh_release_to_pay != 'exception'"/>
                <field name="eh_release_to_pay" widget="badge"
                       decoration-muted="eh_release_to_pay == 'not_ready'"
                       decoration-warning="eh_release_to_pay == 'hold'"
                       decoration-danger="eh_release_to_pay == 'exception'"
                       decoration-info="eh_release_to_pay == 'exception_waived'"
                       decoration-success="eh_release_to_pay in ('released', 'settled')"
                       invisible="move_type != 'in_invoice'"/>
            </header>
            <sheet position="inside">
                <group name="eh_release_to_pay_group"
                       invisible="move_type != 'in_invoice'">
                    <field name="eh_ap_intake_id" readonly="1"/>
                    <field name="eh_payment_action_reason"
                           groups="eh_account_base.group_eh_manager"
                           invisible="state != 'posted'"
                           placeholder="Required reason for the next payment-control action"/>
                    <field name="eh_hold_reason" readonly="1"
                           invisible="not eh_payment_hold"/>
                    <field name="eh_held_at" readonly="1"/>
                    <field name="eh_held_by_id" readonly="1"/>
                    <field name="eh_released_at" readonly="1"/>
                    <field name="eh_released_by_id" readonly="1"/>
                    <field name="eh_exception_waived" readonly="1"/>
                    <field name="eh_exception_waiver_reason" readonly="1"
                           invisible="not eh_exception_waived"/>
                    <field name="eh_exception_waived_at" readonly="1"
                           invisible="not eh_exception_waived"/>
                    <field name="eh_exception_waived_by_id" readonly="1"
                           invisible="not eh_exception_waived"/>
                    <field name="eh_exception_waiver_fingerprint" readonly="1"
                           invisible="not eh_exception_waived"/>
                    <field name="eh_payment_hold_log_ids" readonly="1">
                        <list create="0" edit="0" delete="0">
                            <field name="action_at"/>
                            <field name="action"/>
                            <field name="actor_id"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </group>
            </sheet>
        </field>
    </record>

</odoo>
