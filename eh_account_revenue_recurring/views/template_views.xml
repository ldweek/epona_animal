<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_eh_recurring_template_form_revenue" model="ir.ui.view">
        <field name="name">eh.recurring.invoice.template.form.revenue.bridge</field>
        <field name="model">eh.recurring.invoice.template</field>
        <field name="inherit_id"
               ref="eh_account_recurring_invoices.view_eh_recurring_template_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="revenue_contract_id"/>
            </field>
        </field>
    </record>

    <record id="view_eh_recurring_template_tree_revenue" model="ir.ui.view">
        <field name="name">eh.recurring.invoice.template.list.revenue.bridge</field>
        <field name="model">eh.recurring.invoice.template</field>
        <field name="inherit_id"
               ref="eh_account_recurring_invoices.view_eh_recurring_template_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="revenue_contract_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_revenue_recurring_correction" model="ir.ui.view">
        <field name="name">account.move.form.revenue.recurring.correction</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="eh_revenue_contract_id" invisible="1"/>
                <field name="eh_revenue_billing_registered" invisible="1"/>
                <field name="eh_revenue_billing_correction_of_id" invisible="1"/>
                <button name="action_reverse_revenue_billing" type="object"
                        string="Revenue Billing Correction"
                        groups="eh_account_base.group_eh_manager"
                        invisible="state != 'posted' or move_type != 'out_invoice' or not eh_revenue_billing_registered"
                        confirm="Post one verified sealed credit note, reconcile it to this invoice, and decrement the linked contract billing anchor?"/>
            </xpath>
            <xpath expr="//page[@name='other_info']//field[@name='invoice_origin']"
                   position="after">
                <field name="eh_revenue_billing_registered"
                       readonly="1"
                       invisible="not eh_revenue_contract_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_eh_revenue_contract_form_recurring_financing"
            model="ir.ui.view">
        <field name="name">eh.revenue.contract.form.recurring.financing</field>
        <field name="model">eh.revenue.contract</field>
        <field name="inherit_id"
               ref="eh_account_revenue.view_eh_revenue_contract_form"/>
        <field name="arch" type="xml">
            <field name="financing_interest_recognised" position="after">
                <field name="eh_recurring_financing_receivable_adjustment"
                       invisible="not financing_component"/>
            </field>
        </field>
    </record>

</odoo>
