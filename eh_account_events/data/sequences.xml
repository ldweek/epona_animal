<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_accounting_change" model="ir.sequence">
            <field name="name">EH Accounting Change Reference</field>
            <field name="code">eh.accounting.change</field>
            <field name="prefix">IAS8/%(year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="seq_eh_subsequent_event" model="ir.sequence">
            <field name="name">EH Subsequent Event Reference</field>
            <field name="code">eh.subsequent.event</field>
            <field name="prefix">IAS10/%(year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
