<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">

        <record id="seq_eh_batch_payment_inbound" model="ir.sequence">
            <field name="name">EH Inbound Batch Payment Reference</field>
            <field name="code">eh.batch.payment.inbound</field>
            <field name="prefix">BATCH-IN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="seq_eh_batch_payment_outbound" model="ir.sequence">
            <field name="name">EH Outbound Batch Payment Reference</field>
            <field name="code">eh.batch.payment.outbound</field>
            <field name="prefix">BATCH-OUT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

    </data>
</odoo>
