            <field name="global" eval="True"/>
        </record>

        <record id="eh_consol_equity_rollforward_company_rule" model="ir.rule">
            <field name="name">Equity rollforward: allowed companies</field>
            <field name="model_id" ref="model_eh_consol_equity_rollforward"/>
            <field name="domain_force">[('eh_company_scope_allowed', '=', True)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="eh_consol_disposal_event_company_rule" model="ir.rule">
            <field name="name">Disposal event: allowed companies</field>
