<?xml version="1.0" encoding="utf-8"?>
<!--
    ERP Heritage
    Copyright (C) 2026 (https://www.erpheritage.com.au/)

    Multi-company record rules. A user only sees a consolidation graph when
    its parent, dedicated consolidation ledger and every member company are
    all enabled in the request's current company context. Without the full
    closure, an internal user could read or mutate another group company's
    consolidated figures through a child model.
-->
<odoo>
    <data noupdate="1">

        <record id="eh_consol_entity_company_rule" model="ir.rule">
            <field name="name">Consolidation entity: allowed companies</field>
            <field name="model_id" ref="model_eh_consol_entity"/>
            <field name="domain_force">[('eh_company_scope_allowed', '=', True)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="eh_consol_member_company_rule" model="ir.rule">
            <field name="name">Consolidation member: allowed companies</field>
            <field name="model_id" ref="model_eh_consol_member"/>
