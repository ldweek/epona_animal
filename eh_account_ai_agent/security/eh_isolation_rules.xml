<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Multi-company isolation rules for eh_account_ai_agent.
    One ir.rule per concrete model carrying a company_id.
-->
<odoo noupdate="0">
    <data>

        <record id="rule_eh_account_anomaly_finding_company" model="ir.rule">
            <field name="name">eh.account.anomaly.finding: company isolation</field>
            <field name="model_id" ref="model_eh_account_anomaly_finding"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_account_anomaly_review_event_company" model="ir.rule">
            <field name="name">eh.account.anomaly.review.event: company isolation</field>
            <field name="model_id" ref="model_eh_account_anomaly_review_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_eh_account_anomaly_scan_cache_company" model="ir.rule">
            <field name="name">eh.account.anomaly.scan.cache: company isolation</field>
            <field name="model_id" ref="model_eh_account_anomaly_scan_cache"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
