<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
    <data>

        <record id="privilege_eh_ai_scan" model="res.groups.privilege">
            <field name="name">EH AI Network Scan</field>
            <field name="sequence">91</field>
        </record>

        <record id="group_eh_ai_scanner" model="res.groups">
            <field name="name">AI anomaly scanner</field>
            <field name="privilege_id" ref="privilege_eh_ai_scan"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
            <field name="comment">May run bounded journal anomaly scans, including configured paid/network providers. Does not grant anomaly review authority.</field>
        </record>

        <record id="privilege_eh_ai_review" model="res.groups.privilege">
            <field name="name">EH AI Review</field>
            <field name="sequence">92</field>
        </record>

        <record id="group_eh_ai_reviewer" model="res.groups">
            <field name="name">AI anomaly reviewer</field>
            <field name="privilege_id" ref="privilege_eh_ai_review"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
            <field name="comment">May triage anomaly findings for entries posted by somebody else. Does not grant scan or accounting write authority.</field>
        </record>

    </data>
</odoo>
