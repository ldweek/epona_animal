<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_eh_ic_integrity_review_wizard_form" model="ir.ui.view">
        <field name="name">eh.ic.integrity.review.wizard.form</field>
        <field name="model">eh.ic.integrity.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review inter-company pair">
                <group>
                    <field name="sale_order_id" invisible="not sale_order_id"/>
                    <field name="purchase_order_id" invisible="not purchase_order_id"/>
                    <field name="review_note" placeholder="Evidence checked and conclusion..."/>
                </group>
                <footer>
                    <button name="action_review" type="object"
                            string="Attest and Release" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_eh_ic_manual_fulfillment_wizard_form" model="ir.ui.view">
        <field name="name">eh.ic.manual.fulfillment.wizard.form</field>
        <field name="model">eh.ic.manual.fulfillment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record inter-company fulfilment">
                <group>
                    <field name="sale_line_id" invisible="not sale_line_id"/>
                    <field name="purchase_line_id" invisible="not purchase_line_id"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Record on Both Orders" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
