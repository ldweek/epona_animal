<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_eh_close_task_block_wizard_form" model="ir.ui.view">
        <field name="name">eh.close.task.block.wizard.form</field>
        <field name="model">eh.close.task.block.wizard</field>
        <field name="arch" type="xml">
            <form string="Block Close Task">
                <group>
                    <field name="task_id"/>
                    <field name="reason"
                           placeholder="Explain the dependency, owner, and expected resolution."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Block Task" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
